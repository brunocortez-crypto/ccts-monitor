        <br />
        <br />
    </label>

    <br />
    <br />
    <label class="textonome">
        ANDRE COELHO BORGES DE MEDEIROS
        <br style="height: 5px" />
        Presidente
        <br style="height: 5px" />
        SINDICATO DO COMERCIO DE SANTOS DUMONT
        <br />
        <br />
    </label>
