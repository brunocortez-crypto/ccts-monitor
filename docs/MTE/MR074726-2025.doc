<p>mar/25</p>
</td>
<td>
<p align="right">3,31%</p>
</td>
<td>
<p>&nbsp;R$&nbsp;&nbsp; 411,38</p>
</td>
</tr>
<tr>
<td width="100">
<p>abr/25</p>
</td>
<td>
<p align="right">2,89%</p>
</td>
