<p>&nbsp;R$&nbsp;&nbsp; 359,18</p>
</td>
</tr>
<tr>
<td width="100">
<p>mai/25</p>
</td>
<td>
<p align="right">2,47%</p>
</td>
<td>
<p>&nbsp;R$&nbsp;&nbsp; 306,98</p>
</td>
</tr>
<tr>
<td width="100">
<p>jun/25</p>
</td>
<td>
<p align="right">2,06%</p>
</td>
<td>
<p>&nbsp;R$&nbsp;&nbsp; 256,03</p>
</td>
</tr>
<tr>
<td width="100">
<p>jul/25</p>
</td>
<td>
<p align="right">1,64%</p>
</td>
<td>
<p>&nbsp;R$&nbsp;&nbsp; 203,83</p>
</td>
