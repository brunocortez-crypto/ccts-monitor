        <br style="height: 5px" />
        SINDPAS - SINDICATO DAS EMPRESAS DE TRANSPORTE DE PASSAGEIRO
        <br />
        <br />
    </label>

    <br />
    <br />
    <label class="textonome">
        CELIO MOREIRA DA SILVA
        <br style="height: 5px" />
        Presidente
        <br style="height: 5px" />
        SINDICATO DOS TRABALHADORES EM TRANSPORTES RODOVIARIOS DE UBERLANDIA
        <br />
        <br />
    </label>
                                            </td>
                                        </tr>
                                    </table>
                                        <br />
                                        <center>
                                            <label class="textogrupo">
                                                <b>ANEXOS </b>
                                            </label>
                                        </center>
                                                        <label>
                                                            <b>
                                                                <center>
                                                                    <label class="textogrupo">
                                                                        ANEXO I - ATA DIGITALIZADA DA ASSEMBLEIA DO SINDICATO PROFISSIONAL
                                                                    </label>
                                                                </center>
                                                                <label class="tituloClausula">
                                                                                                                                    </label>
                                                            </b>
                                                        </label>
                                                        <b>
                                                            <label>

                                                            </label>
                                                        </b>
                                                        <br />
                                                        <label class="descricaoClausula" >
                                                            <p><a href="https://www3.mte.gov.br/sistemas/mediador/imagemAnexo/MR046144_20252025_08_01T09_33_25.pdf" target="_blank">Anexo (PDF)</a></p>
                                                        </label>
                                                        <br />
