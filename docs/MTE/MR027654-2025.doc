                                            <label class="texto">
                                                &#160;&#160;&#160;&#160;A autenticidade deste documento poderá ser confirmada na
                                                página do Ministerio do Trabalho e Emprego na Internet, no endereço http://www.mte.gov.br.
                                            </label>
                                            <br />
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </center>
    </div>
</body>
<script>
    setTimeout(function () {
        window.history.replaceState({}, '', window.location.pathname);
    }, 0);
</script>
