                                        <br />
                                        <center>
                                            <label class="textogrupo">
                                                <b>ANEXOS </b>
                                            </label>
                                        </center>
                                                        <label>
                                                            <b>
                                                                <center>
                                                                    <label class="textogrupo">
                                                                        ANEXO I - ATA DE ASSEMBLEIA
                                                                    </label>
                                                                </center>
                                                                <label class="tituloClausula">
                                                                                                                                    </label>
                                                            </b>
                                                        </label>
                                                        <b>
                                                            <label>

                                                            </label>
                                                        </b>
                                                        <br />
                                                        <label class="descricaoClausula" >
                                                            <p><a href="https://www3.mte.gov.br/sistemas/mediador/imagemAnexo/MR009667_20262026_04_17T10_36_09.pdf" target="_blank">Anexo (PDF)</a></p>
                                                        </label>
                                                        <br />
                                                        <label>
                                                            <b>
                                                                <center>
                                                                    <label class="textogrupo">
                                                                        ANEXO II - LISTA DE ASSEMBLEIA 
                                                                    </label>
                                                                </center>
                                                                <label class="tituloClausula">
