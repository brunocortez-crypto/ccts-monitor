<tr>
<td valign="top" width="156">
<p>Setembro&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;2025</p>
</td>
<td valign="top" width="94">
<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 1,50%</p>
</td>
<td valign="top" width="139">
<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 1,015</p>
</td>
</tr>
<tr>
<td valign="top" width="156">
<p>Outubro&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 2025</p>
</td>
<td valign="top" width="94">
<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 1,00%</p>
</td>
<td valign="top" width="139">
<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 1,010</p>
</td>
</tr>
<tr>
<td valign="top" width="156">
<p>Novembro&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 2025</p>
</td>
<td valign="top" width="94">
<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 0,50%</p>
</td>
<td valign="top" width="139">
<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 1,005</p>
</td>
</tr>
