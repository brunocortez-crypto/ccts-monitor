</td>
<td width="132">
<p align="center"><strong>2.543,20</strong></p>
</td>
<td width="130">
<p align="center"><strong>11,56</strong></p>
</td>
</tr>
<tr>
<td width="179">
<p align="center"><strong>APONTADOR</strong></p>
</td>
<td width="132">
<p align="center"><strong>2.543,20</strong></p>
</td>
<td width="130">
<p align="center"><strong>11,56</strong></p>
</td>
</tr>
<tr>
<td width="179">
<p align="center"><strong>ALMOXARIFE</strong></p>
</td>
<td width="132">
