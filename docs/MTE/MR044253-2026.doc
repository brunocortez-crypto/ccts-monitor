                                            <label class="textogrupo">
                                                <b>ANEXOS </b>
                                            </label>
                                        </center>
                                                        <label>
                                                            <b>
                                                                <center>
                                                                    <label class="textogrupo">
                                                                        ANEXO I - ATA ASSEMBLEIA INDUSTRIA 2026
                                                                    </label>
                                                                </center>
                                                                <label class="tituloClausula">
                                                                                                                                    </label>
                                                            </b>
                                                        </label>
                                                        <b>
                                                            <label>

                                                            </label>
                                                        </b>
                                                        <br />
                                                        <label class="descricaoClausula" >
                                                            <p><a href="https://mediador.trabalho.gov.br/sistemas/mediador/imagemAnexo/MR044253_20262026_07_22T11_07_59.pdf" target="_blank">Anexo (PDF)</a></p>
                                                        </label>
                                                        <br />
