                                                                    <label class="textogrupo">
                                                                        ANEXO I - ATA DE ASSEMBLEIA 
                                                                    </label>
                                                                </center>
                                                                <label class="tituloClausula">
                                                                                                                                    </label>
                                                            </b>
                                                        </label>
                                                        <b>
                                                            <label>

                                                            </label>
                                                        </b>
