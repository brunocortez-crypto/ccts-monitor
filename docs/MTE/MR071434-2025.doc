                                            <label class="textogrupo">
                                                <b>ANEXOS </b>
                                            </label>
                                        </center>
                                                        <label>
                                                            <b>
                                                                <center>
                                                                    <label class="textogrupo">
                                                                        ANEXO I - ATA ASSEMBLEIA
                                                                    </label>
                                                                </center>
                                                                <label class="tituloClausula">
                                                                                                                                    </label>
                                                            </b>
                                                        </label>
                                                        <b>
                                                            <label>

                                                            </label>
                                                        </b>
                                                        <br />
                                                        <label class="descricaoClausula" >
                                                            <p><a href="https://www3.mte.gov.br/sistemas/mediador/imagemAnexo/MR071434_20252025_11_14T16_42_42.pdf" target="_blank">Anexo (PDF)</a></p>
                                                        </label>
                                                        <br />
