                                        <tr>
                                            <td align="center">
                                                    <br />
    <br />
    <label class="textonome">
        ARIOLDO CARVALHO VASCONCELOS
        <br style="height: 5px" />
        Presidente
        <br style="height: 5px" />
        SIND EMPREGADOS DE AGENTES AUTONOMOS DO COM EST GOIAS
        <br />
        <br />
    </label>

    <br />
