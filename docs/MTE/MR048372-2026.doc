                                                                        ANEXO I - ATA DA ASSEMBL&#201;IA GERAL SEACOM 
                                                                    </label>
                                                                </center>
                                                                <label class="tituloClausula">
                                                                                                                                    </label>
                                                            </b>
                                                        </label>
                                                        <b>
                                                            <label>

