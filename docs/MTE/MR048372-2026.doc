                                                                        ANEXO II - RELA&#199;&#195;O DE EMPRESAS ABRANGIDAS PELA CONVEN&#199;&#195;O 
                                                                    </label>
                                                                </center>
                                                                <label class="tituloClausula">
                                                                                                                                    </label>
                                                            </b>
                                                        </label>
                                                        <b>
                                                            <label>

                                                            </label>
