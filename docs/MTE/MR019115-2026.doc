<td valign="top" width="158">
<p><strong>MAIO/2025</strong></p>
</td>
<td valign="top" width="106">
<p align="center">4,53</p>
</td>
</tr>
<tr>
<td valign="top" width="158">
<p><strong>JUNHO/2025</strong></p>
</td>
<td valign="top" width="106">
<p align="center">3,96</p>
</td>
