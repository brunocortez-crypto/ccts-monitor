<tr>
<td valign="top" width="158">
<p><strong>JULHO/2025</strong></p>
</td>
<td valign="top" width="106">
<p align="center">3,40</p>
</td>
</tr>
<tr>
<td valign="top" width="158">
<p><strong>AGOSTO/2025</strong></p>
</td>
<td valign="top" width="106">
<p align="center">2,83</p>
</td>
</tr>
<tr>
<td valign="top" width="158">
<p><strong>SETEMBRO/2025</strong></p>
</td>
<td valign="top" width="106">
<p align="center">2,26</p>
</td>
